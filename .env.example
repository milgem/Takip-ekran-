# Bu dosyayı ".env" adıyla kopyalayıp doldurun:  cp .env.example .env

# Panelin açılacağı adres (DNS'te sunucunuzun IP'sine yönlendirilmiş olmalı)
DOMAIN=panel.ornekalanadi.com

# Giriş bilgileri
ADMIN_USER=fatih
ADMIN_PASSWORD=buraya-guclu-bir-sifre-yazin

# Rastgele en az 32 karakter. Üretmek için:  openssl rand -hex 32
# DİKKAT: Sonradan değiştirirseniz kayıtlı API anahtarları çözülemez, yeniden girmeniz gerekir.
SECRET_KEY=

DATABASE_URL=sqlite:////srv/data/panel.db
TIMEZONE=Europe/Istanbul

# Kaç dakikada bir veri çekilsin
SYNC_MINUTES=30
# Yeni bağlantıda kaç günlük geçmiş çekilsin
BACKFILL_DAYS=60

# API sürümleri (platformlar eski sürümü kapattığında buradan güncelleyin)
SHOPIFY_API_VERSION=2026-07
META_API_VERSION=v26.0
GOOGLE_ADS_API_VERSION=v26
